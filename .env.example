# Server only. Used by /api/ai/* once the Claude calls replace the stubs.
ANTHROPIC_API_KEY=

# Public. Devnet RPC endpoint used by the browser wallet client.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Public. Address of the deployed program on devnet.
NEXT_PUBLIC_PROGRAM_ID=

# Server only. Platform authority keypair (base58 or JSON array) that signs
# verdict commits, volunteer assignments and KYC records. Never expose it.
PLATFORM_AUTHORITY_SECRET=

# Server only. Random string used to sign session cookies (openssl rand -hex 32).
SESSION_SECRET=
